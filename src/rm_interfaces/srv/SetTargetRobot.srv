# SetTargetRobot.srv
# Service for setting the target robot ID.
# Kept for compatibility with higher-level planning tools.

# Request
string robot_id              # Target robot ID to track ("1"~"5", "outpost", "base", or "" to clear)
---
# Response
bool success                 # Whether the target was successfully set
string message               # Status message
string previous_robot_id     # Previous target robot ID (if any)

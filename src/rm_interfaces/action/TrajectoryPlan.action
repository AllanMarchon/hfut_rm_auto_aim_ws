# TrajectoryPlan.action
# Action for trajectory planning control
# Used by target_selector to control trajectory_planner

# Goal - Request trajectory planning for a target robot
string robot_id              # Target robot ID to track and plan trajectory for
float64 reference_yaw        # Reference yaw direction for aiming (rad)
bool enable_tracking         # Whether to enable continuous tracking
---
# Result - Final result when action completes
bool success                 # Whether the action completed successfully
string message               # Status message
float64 total_tracking_time  # Total tracking time (seconds)
---
# Feedback - Continuous feedback during trajectory planning
std_msgs/Header header
string current_robot_id      # Currently tracking robot ID
float64 yaw_error            # Current yaw error from target (rad)
float64 pitch_error          # Current pitch error from target (rad)
float64 distance             # Distance to target (m)
bool target_locked           # Whether target is locked
uint8 planning_status        # Planning status: 0=IDLE, 1=PLANNING, 2=TRACKING, 3=LOST_TARGET

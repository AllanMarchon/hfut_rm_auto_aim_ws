<?xml version="1.0" encoding="utf-8"?>

<!--
  Dual-camera model for pipeline tests.
  Camera poses are defined relative to gimbal_link and can be overridden
  via xacro args from launch config.
-->

<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="test_pipeline_dual_video">

  <xacro:arg name="gimbal_xyz" default="0 0 0" />
  <xacro:arg name="gimbal_rpy" default="0 0 0" />

  <xacro:arg name="camera1_xyz" default="0.05 0.06 0.05" />
  <xacro:arg name="camera1_rpy" default="0 0 0" />

  <xacro:arg name="camera2_xyz" default="0.05 -0.06 0.05" />
  <xacro:arg name="camera2_rpy" default="0 0 0" />

  <link name="odom" />
  <link name="base_link" />

  <joint name="odom_to_base_link" type="fixed">
    <parent link="odom" />
    <child link="base_link" />
    <origin xyz="0 0 0" rpy="0 0 0" />
  </joint>

  <link name="gimbal_link" />
  <joint name="base_to_gimbal" type="fixed">
    <parent link="base_link" />
    <child link="gimbal_link" />
    <origin xyz="$(arg gimbal_xyz)" rpy="$(arg gimbal_rpy)" />
  </joint>

  <link name="camera1_link" />
  <joint name="gimbal_to_camera1" type="fixed">
    <parent link="gimbal_link" />
    <child link="camera1_link" />
    <origin xyz="$(arg camera1_xyz)" rpy="$(arg camera1_rpy)" />
  </joint>

  <link name="camera1_optical_frame" />
  <joint name="camera1_to_optical" type="fixed">
    <parent link="camera1_link" />
    <child link="camera1_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

  <link name="camera2_link" />
  <joint name="gimbal_to_camera2" type="fixed">
    <parent link="gimbal_link" />
    <child link="camera2_link" />
    <origin xyz="$(arg camera2_xyz)" rpy="$(arg camera2_rpy)" />
  </joint>

  <link name="camera2_optical_frame" />
  <joint name="camera2_to_optical" type="fixed">
    <parent link="camera2_link" />
    <child link="camera2_optical_frame" />
    <origin xyz="0 0 0" rpy="${-pi/2} 0 ${-pi/2}" />
  </joint>

</robot>
